# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Data (too large for Git — use Zenodo for benchmark data)
/data/
*.h5
*.nii.gz
*.mat
*.zip
# Do NOT ignore Python package qMR_Robust/data/
!qMR_Robust/data/
!qMR_Robust/data/**
qMR_Robust/data/**/__pycache__/

# Results and checkpoints (regenerated by scripts; large)
results/
*.pt
*.h5

# Global media/json ignores
*.png
*.json

# Local generated and planning materials stay outside version control
paper/figures/
paper/figures/**
frozen_results/
frozen_results/**
docs/
PROJECT_UNDERSTANDING.md
summary_and_TODO.md

# Upload staging (separate packages for Zenodo/arXiv)
upload/

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# OS
.DS_Store
Thumbs.db
._*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary
/tmp/
paper/TODO.md
paper/template*.tex
scripts/write_*.py
scripts/fix_*.py
